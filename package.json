{
  "name": "@accelerationagency/cesium-i3s-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Web Mercator scene layers, atlas-texture remapping, and load tuning for CesiumJS I3S",
  "license": "Apache-2.0",
  "author": "The Acceleration Agency, LLC <opensource@theaccelerationagency.com>",
  "repository": { "type": "git", "url": "git+https://github.com/AccelerationAgency/cesium-i3s-extensions.git" },
  "homepage": "https://github.com/AccelerationAgency/cesium-i3s-extensions#readme",
  "bugs": { "url": "https://github.com/AccelerationAgency/cesium-i3s-extensions/issues" },
  "keywords": ["cesium", "cesiumjs", "i3s", "scene-layer", "arcgis", "3d-tiles", "web-mercator", "texture-atlas", "gis"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./package.json": "./package.json" },
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "bin": { "cesium-i3s-build-worker": "worker/build-worker.mjs", "cesium-i3s-verify-worker": "worker/verify-worker.mjs" },
  "files": ["dist", "NOTICE", "worker/build-worker.mjs", "worker/verify-worker.mjs", "worker/base.json", "worker/src", "worker/patched", "worker/decodeI3S.patch"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sanitize": "node scripts/sanitize-check.mjs",
    "worker:build": "node worker/build-worker.mjs --out demo/public/cesium/Workers",
    "worker:diff": "node worker/make-patch.mjs",
    "demo": "npm run worker:build && vite demo"
  },
  "peerDependencies": { "cesium": "1.145.0" },
  "dependencies": { "esbuild": "^0.21.5" },
  "overrides": { "@cesium/widgets": "16.2.0" },
  "devDependencies": { "@types/node": "^20.19.43", "cesium": "1.145.0", "typescript": "^5.4.0", "vitest": "^1.6.0", "vite": "^5.2.0", "vite-plugin-static-copy": "^1.0.0" }
}
